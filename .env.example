# -----------------------------------------------------------------------------
# Nosso After — variáveis de ambiente
# Copie para .env.local (dev). NUNCA commite valores reais.
# Em staging/production configure no provedor de hospedagem (secrets manager).
# -----------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
# URL pública da aplicação (usada em links de e-mail, webhooks e sitemap)
APP_URL=http://localhost:3000

# PostgreSQL. Em dev, `npm run db:start` sobe um Postgres embutido na porta 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nossoafter

# Segredos da aplicação — gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Mínimo de 32 caracteres. Use valores DIFERENTES por ambiente.
QR_SIGNING_SECRET=
ORDER_ACCESS_SECRET=
CRON_SECRET=

# Minutos de reserva de estoque durante o checkout
ORDER_RESERVATION_MINUTES=15

# -----------------------------------------------------------------------------
# Pagamentos
# mock        -> ambiente DEMO (simulador local, nenhum dinheiro envolvido; proibido em production)
# mercadopago -> SANDBOX ou PRODUCTION, conforme MERCADOPAGO_ENVIRONMENT
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
MOCK_PSP_WEBHOOK_SECRET=

# Mercado Pago (Suas integrações > Credenciais). Test credentials em dev/staging.
# sandbox | production  (production só é aceito com APP_ENV=production)
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Suas integrações > Webhooks > Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=
# Texto que aparece na fatura do cartão (máx. 13 caracteres)
MERCADOPAGO_STATEMENT_DESCRIPTOR=NOSSOAFTER

# -----------------------------------------------------------------------------
# Seed de desenvolvimento (npm run db:seed) — só roda com APP_ENV=development
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@nossoafter.local
SEED_ADMIN_PASSWORD=

# Log level: debug | info | warn | error
LOG_LEVEL=info
